{
  "name": "desktop-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:js": "eslint web/app.js web/control/control.js eslint.config.js",
    "lint:py": ".venv/bin/ruff check .",
    "lint": "pnpm run lint:js && pnpm run lint:py",
    "test": "/usr/bin/python3 -m unittest discover -s tests",
